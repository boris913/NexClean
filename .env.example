# ─── Coordonnées ─────────────────────────────────────────────
# Les coordonnées (téléphone, WhatsApp, e-mail, adresse, réseaux) se modifient
# dans lib/constants.ts — source unique utilisée par tout le site.

# ─── Analytics (optionnel) ───────────────────────────────────
# Mesure des clics WhatsApp / appels / formulaires / candidatures / commandes.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ─── Google Search Console (optionnel) ───────────────────────
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxx

# ─── Recrutement : envoi des candidatures + CV ───────────────
# Clé API Resend (https://resend.com). Sans elle, le formulaire bascule sur WhatsApp.
# RESEND_API_KEY=re_xxxxxxxx
# Destinataire des candidatures (défaut : e-mail de lib/constants.ts)
# RECRUITMENT_EMAIL=recrutement@nexclean.xyz
# Expéditeur vérifié dans Resend (domaine nexclean.xyz à vérifier)
# RECRUITMENT_FROM_EMAIL=NexClean Recrutement <recrutement@nexclean.xyz>
# Optionnel : webhook (ex. Google Apps Script) pour ajouter chaque candidature
# dans un Google Sheet (consultation, filtres, export).
# CANDIDATURE_WEBHOOK_URL=https://script.google.com/macros/s/xxxx/exec

# ─── Back-Office (specs/MVP1-01) ─────────────────────────────
# Base PostgreSQL (sur le VPS : réseau Docker interne uniquement, ADR 0002)
# DATABASE_URL=postgresql://nexclean:motdepasse@localhost:5432/nexclean_dev
# Secret Better Auth : 32+ caractères aléatoires (ex. `openssl rand -base64 48`)
# BETTER_AUTH_SECRET=
# URL publique de l'application (liens d'activation, cookies sécurisés en https)
# BETTER_AUTH_URL=http://localhost:3000
# Répertoire des documents, hors racine web (ADR 0003)
# STORAGE_DIR=./storage
# Expéditeur des e-mails du Back-Office (domaine vérifié dans Resend)
# BACKOFFICE_FROM_EMAIL=NexClean <no-reply@nexclean.xyz>
# Tests d'intégration : base dédiée dont le nom se termine par _test (elle est effacée !)
# DATABASE_URL_TEST=postgresql://nexclean:motdepasse@localhost:5432/nexclean_test
